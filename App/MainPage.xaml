<Page
    x:Class="XboxBrave.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Background="#0D0D0D">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#1A1A1A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ShieldsIcon" Text="🛡" FontSize="20"
                       Foreground="#FF7A00" VerticalAlignment="Center"
                       Margin="16,0,8,0" Grid.Column="0"/>

            <TextBox x:Name="AddressBar" Grid.Column="1"
                     PlaceholderText="ادخل رابط الموقع..."
                     Background="#2A2A2A" Foreground="White"
                     BorderThickness="0" CornerRadius="18"
                     Height="36" Margin="8,0"
                     VerticalContentAlignment="Center"
                     KeyDown="AddressBar_KeyDown"/>

            <TextBlock x:Name="BlockedCount" Text="0" Grid.Column="2"
                       Foreground="#888888" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,16,0"/>
        </Grid>

        <controls:WebView2 x:Name="Browser" Grid.Row="1"
                            CoreWebView2Initialized="Browser_CoreWebView2Initialized"/>
    </Grid>
</Page>
